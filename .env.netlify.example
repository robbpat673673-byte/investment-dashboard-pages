# Required: external MySQL database that has received the existing Drizzle schema.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Required: OpenAI-compatible API used by 財經小智、新聞摘要與每日摘要.
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-5-mini

# Build-time public setting. This activates Netlify-specific frontend behaviours.
VITE_RUNTIME_TARGET=netlify

# Optional: only set if the site uses a separate public API origin.
# VITE_API_ORIGIN=

# Netlify Identity is configured in the Netlify dashboard. Do not put its admin secrets here.
# Create the first owner as an Identity user and give that user the app_metadata role: admin.

